# Copy this file to .env locally. Never commit .env or private-key material.
AGENT_ID=observer-1
HTTP_LISTEN_ADDR=:8080
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1337
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
ETH_ADDRESS=0x0000000000000000000000000000000000000000
ETH_PRIVATE_KEY=replace-with-a-local-development-key
HPPK_PUBLIC_KEY_PATH=/absolute/path/outside/repositories/agent-a-pk.json
HPPK_SECRET_KEY_PATH=/absolute/path/outside/repositories/agent-a-sk.json
STATE_FILE=./data/agent-state.json
EXPECTED_STEP=1
ENABLE_PAYLOAD_COMPARE=true
MAX_CLOCK_SKEW=2m
